#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
config_dir="${TAWX_DESKTOP_HOME:-${HOME}/tawx-desktop}"
config_path="${TAWX_DESKTOP_CONFIG:-${config_dir}/config.yaml}"
legacy_config="${HOME}/taw-cowork/config.yaml"
broker_bind="${ROUTELLM_BROKER_BIND:-127.0.0.1:19100}"
auth_bind="${ROUTELLM_AUTH_BIND:-127.0.0.1:19101}"
broker_url="http://${broker_bind}"
export OMP_AUTH_GATEWAY_URL="http://${auth_bind}"
pids=()

roles_json="$(omp config get modelRoles --json)"
models_json="$(omp models --json)"
resolve_role() {
  local role_value
  role_value="$(jq -r --arg role "$1" '.value[$role] // empty' <<<"$roles_json")"
  jq -r --arg value "$role_value" \
    '([.models[] | select(.selector == $value)][0] // [.models[] | select(.id == $value)][0]).selector // empty' \
    <<<"$models_json"
}

: "${OMP_ROUTER_CLASSIFIER_MODEL:=$(resolve_role smol)}"
: "${OMP_ROUTER_FAST_MODEL:=$(resolve_role default)}"
: "${OMP_ROUTER_CODING_MODEL:=$(resolve_role main)}"
: "${OMP_ROUTER_REASONING_MODEL:=$(resolve_role slow)}"
: "${OMP_ROUTER_CREATIVE_MODEL:=$(resolve_role main)}"
: "${OMP_ROUTER_GENERAL_MODEL:=$(resolve_role default)}"
export OMP_ROUTER_CLASSIFIER_MODEL OMP_ROUTER_FAST_MODEL OMP_ROUTER_CODING_MODEL
export OMP_ROUTER_REASONING_MODEL OMP_ROUTER_CREATIVE_MODEL OMP_ROUTER_GENERAL_MODEL

# Reuse the vault credential for OpenRouter-only server tools.
export OPENROUTER_API_KEY="$(omp token openrouter)"

if [[ ! -f "$config_path" ]]; then
  install -d -m 700 "$config_dir"
  source_config="$repo_dir/etc/config.omp.yaml"
  [[ -f "$legacy_config" ]] && source_config="$legacy_config"
  install -m 600 "$source_config" "$config_path"
fi

cleanup() {
  for pid in "${pids[@]}"; do
    kill "$pid" 2>/dev/null || true
  done
  wait "${pids[@]}" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

omp auth-broker serve --bind="$broker_bind" &
pids+=("$!")
broker_token="$(omp auth-broker token)"

broker_ready=false
for _ in {1..50}; do
  if curl -s -o /dev/null -H "Authorization: Bearer $broker_token" "$broker_url/"; then
    broker_ready=true
    break
  fi
  sleep 0.1
done
if [[ "$broker_ready" != true ]]; then
  echo "OMP auth broker did not start at $broker_url" >&2
  exit 1
fi

OMP_AUTH_BROKER_URL="$broker_url" OMP_AUTH_BROKER_TOKEN="$broker_token" \
  omp auth-gateway serve --no-auth --bind="$auth_bind" &
pids+=("$!")

auth_ready=false
for _ in {1..50}; do
  if curl -fs -o /dev/null "$OMP_AUTH_GATEWAY_URL/v1/models"; then
    auth_ready=true
    break
  fi
  sleep 0.1
done
if [[ "$auth_ready" != true ]]; then
  echo "OMP auth gateway did not start at $OMP_AUTH_GATEWAY_URL" >&2
  exit 1
fi

cd "$repo_dir"
if [[ -n "${TAWX_DESKTOP_BIN:-}" ]]; then
  "$TAWX_DESKTOP_BIN" run "$config_path" &
else
  go run ./cmd/llm-gateway run "$config_path" &
fi
gateway_pid="$!"
pids+=("$gateway_pid")
wait "$gateway_pid"
