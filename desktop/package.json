{
  "name": "tawx-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "TAWX Desktop app",
  "author": "TAW Group",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "build:gateway": "mkdir -p gateway-bin && go build -o gateway-bin/tawx-desktop ../cmd/llm-gateway",
    "dist:mac": "npm run build:gateway && electron-builder --mac dir --arm64"
  },
  "devDependencies": {
    "electron": "30.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.tawgroup.tawx-desktop",
    "productName": "TAWX Desktop",
    "files": [
      "main.cjs"
    ],
    "extraResources": [
      {
        "from": "gateway-bin/tawx-desktop",
        "to": "tawx-desktop"
      },
      {
        "from": "../scripts/run-with-omp",
        "to": "scripts/run-with-omp"
      },
      {
        "from": "../etc/config.omp.yaml",
        "to": "etc/config.omp.yaml"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir"
    }
  }
}
